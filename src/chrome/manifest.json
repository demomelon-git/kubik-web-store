{
  "manifest_version": 3,
  "name": "Кубик — главная и поиск",
  "version": "2.3.0",
  "description": "Главная страница и поиск с помощником Кубиком. Результаты нескольких поисковых систем в одной выдаче.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://consent.google.com/*",
    "https://www.bing.com/*",
    "https://api.bing.com/*",
    "https://search.brave.com/*",
    "https://suggestqueries.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://127.0.0.1/*",
    "http://127.0.0.1/*",
    "https://html.duckduckgo.com/*",
    "https://duckduckgo.com/*",
    "https://www.startpage.com/*",
    "https://api.github.com/*",
    "https://demomelon-git.github.io/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "omnibox": {
    "keyword": "kub"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/sorry/*",
        "https://consent.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "newtab.html",
        "results.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": "",
  "update_url": "https://demomelon-git.github.io/kubik-web-store/addons/updates-chrome.xml"
}